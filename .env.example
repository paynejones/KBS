POSTGRES_USER=kb_user
POSTGRES_PASSWORD=replace_me
POSTGRES_DB=knowledge_base
DATABASE_URL=postgresql://kb_user:replace_me@localhost:5432/knowledge_base

# Single-user sign-in. Generate the secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave both unset for local development; production requires them.
KBS_AUTH_PASSWORD=replace_with_a_long_passphrase
KBS_AUTH_SECRET=replace_with_a_32_character_or_longer_secret

# Set to 1 only when a reverse proxy you control appends X-Forwarded-For;
# unset, failed sign-ins are delayed rather than blocked per address.
# KBS_TRUST_PROXY=1

# Optional: where full workspace backups are written (default data/backups).
# BACKUPS_DIR=
